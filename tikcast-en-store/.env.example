# ─── TikCast_en Store — variables d'environnement ───
# Copie ce fichier en `.env.local` (dev) et renseigne les mêmes variables
# dans Vercel → Project → Settings → Environment Variables (production).
# NE JAMAIS commiter de vraies valeurs. NE JAMAIS préfixer un secret par
# NEXT_PUBLIC_ (il serait exposé dans le navigateur).

# URL publique du site (page de retour après paiement)
NEXT_PUBLIC_SITE_URL=https://YOUR-SUBDOMAIN.vercel.app

# Supabase — URL du projet (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase — clé "service_role" (SECRÈTE, serveur uniquement, contourne la RLS)
SUPABASE_SERVICE_ROLE_KEY=

# SasPay — clé API secrète marchand (SECRÈTE, serveur uniquement)
SASPAY_SECRET_KEY=
# SasPay — secret de signature des webhooks (SECRET, serveur uniquement)
SASPAY_WEBHOOK_SECRET=
# SasPay — base API. SANDBOX pour les tests :
#   https://sandbox-api.saspay.me
# PRODUCTION (seulement quand tout est testé) :
#   https://api.saspay.me
# ⚠️ api.saspay.me traite MÊME les clés test comme de la PRODUCTION RÉELLE.
SASPAY_API_BASE=https://sandbox-api.saspay.me
